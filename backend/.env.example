# ==============================================================================
# DAV UNIVERSITY MEDICAL PORTAL - BACKEND ENVIRONMENT CONFIGURATION (RENDER)
# ==============================================================================

# Server Port (Render sets PORT automatically, defaults to 5000)
PORT=5000
NODE_ENV=production

# Frontend URL (Your deployed Vercel domain)
FRONTEND_URL=https://your-frontend.vercel.app

# Render Public URL (Used by the internal keep-alive cron job to prevent sleep)
RENDER_EXTERNAL_URL=https://your-backend-name.onrender.com

# ------------------------------------------------------------------------------
# 1. Cloudinary Credentials (Temporary Proof Document Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 2. Firebase Firestore Credentials (Permanent Source of Truth)
# (Option A: Provide environment variables below, OR)
# (Option B: Upload 'serviceAccountKey.json' in Render -> Secret Files)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=dav-university-medical-reports
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@dav-university-medical-reports.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
