# ==============================================================================
# DAV UNIVERSITY MEDICAL LEAVE APPLICATION PORTAL - CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudinary Credentials (Temporary Proof Document Storage)
# ------------------------------------------------------------------------------
# Student-uploaded medical certificates & prescriptions are stored temporarily
# in Cloudinary until the Faculty PC Sync Agent verifies the local backup,
# after which they are automatically purged.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 2. Firebase Firestore Credentials (Permanent Source of Truth)
# ------------------------------------------------------------------------------
# Used by the backend to store all application data permanently in Firestore.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Faculty PC Sync Agent Settings (Optional Desktop Customization)
# ------------------------------------------------------------------------------
FACULTY_PC_ID=FACULTY-PC-DEAN-01
BACKUP_BASE_DIR=C:\Users\faculty\Documents\DAV Medical Leave
PORTAL_URL=http://localhost:3000
POLL_INTERVAL_SEC=30
